BLOCK RESETPATHS ;
BLOCK ASYNCPATHS ;
SYSCONFIG MCCLK_FREQ=8.31 JTAG_PORT=DISABLE BACKGROUND_RECONFIG=ON MUX_CONFIGURATION_PORTS=ENABLE CONFIGURATION=CFG I2C_PORT=ENABLE SDM_PORT=PROGRAMN ;
BANK 0 VCCIO 3.3 V;
BANK 1 VCCIO 3.3 V;
BANK 2 VCCIO 3.3 V;
BANK 3 VCCIO 3.3 V;
// https://github.com/danderson/ulxs/blob/main/lpf.md
LOCATE COMP "FPGA_CLK" SITE "1" ;
LOCATE COMP "LED_OD" SITE "4" ;
LOCATE COMP "TUNER_CLK" SITE "5" ;
LOCATE COMP "I2S_BCK" SITE "29" ;
LOCATE COMP "I2S_DAT" SITE "30" ;
LOCATE COMP "I2S_WS" SITE "32" ;
LOCATE COMP "D0" SITE "8" ;
LOCATE COMP "D1" SITE "9" ;
LOCATE COMP "D2" SITE "10" ;
LOCATE COMP "D3" SITE "11" ;
LOCATE COMP "D4" SITE "12" ;
LOCATE COMP "D5" SITE "13" ;
LOCATE COMP "D6" SITE "14" ;
LOCATE COMP "D7" SITE "20" ;
LOCATE COMP "DATA_VALID" SITE "21" ;
LOCATE COMP "SYNC" SITE "23" ;
IOBUF PORT "LED_OD" OPENDRAIN=OFF DRIVE=4 PULLMODE=NONE IO_TYPE=LVTTL33 SLEWRATE=SLOW CLAMP=OFF DIFFRESISTOR=OFF DIFFDRIVE="NA" BANK_VCCIO=3.3 HYSTERESIS=NA ;
IOBUF PORT "SCL" PULLMODE=UP IO_TYPE=LVCMOS33 ;
IOBUF PORT "SDA" PULLMODE=UP IO_TYPE=LVCMOS33 ;
IOBUF PORT "I2S_BCK" PULLMODE=NONE DRIVE=12 IO_TYPE=LVTTL33 SLEWRATE=FAST CLAMP=OFF OPENDRAIN=OFF DIFFRESISTOR=OFF DIFFDRIVE="NA" BANK_VCCIO=3.3 HYSTERESIS=NA ;
IOBUF PORT "I2S_DAT" PULLMODE=NONE DRIVE=12 IO_TYPE=LVTTL33 SLEWRATE=FAST CLAMP=OFF OPENDRAIN=OFF DIFFRESISTOR=OFF DIFFDRIVE="NA" BANK_VCCIO=3.3 HYSTERESIS=NA ;
IOBUF PORT "I2S_WS" PULLMODE=NONE DRIVE=12 IO_TYPE=LVTTL33 SLEWRATE=FAST CLAMP=OFF OPENDRAIN=OFF DIFFRESISTOR=OFF DIFFDRIVE="NA" BANK_VCCIO=3.3 HYSTERESIS=NA ;
IOBUF PORT "FPGA_CLK" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=NA SLEWRATE=NA CLAMP=ON ;
IOBUF PORT "TUNER_CLK" PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF PORT "D0" PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF PORT "D1" PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF PORT "D2" PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF PORT "D3" PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF PORT "D4" PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF PORT "D5" PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF PORT "D6" PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF PORT "D7" PULLMODE=UP IO_TYPE=LVCMOS33 ;
IOBUF PORT "DATA_VALID" PULLMODE=DOWN IO_TYPE=LVCMOS33 ;
IOBUF PORT "SYNC" PULLMODE=DOWN IO_TYPE=LVCMOS33 DRIVE=NA SLEWRATE=NA CLAMP=ON OPENDRAIN=OFF DIFFRESISTOR=OFF DIFFDRIVE="NA" BANK_VCCIO=3.3 HYSTERESIS=SMALL ;
FREQUENCY PORT "FPGA_CLK" 40.000000 MHz;
FREQUENCY PORT "TUNER_CLK" 8.000000 MHz;
VCCIO_DERATE PERCENT 0;
USE PRIMARY NET "FPGA_CLK_c" ;

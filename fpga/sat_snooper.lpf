BLOCK RESETPATHS ;
BLOCK ASYNCPATHS ;
SYSCONFIG MCCLK_FREQ=7 JTAG_PORT=DISABLE BACKGROUND_RECONFIG=ON MUX_CONFIGURATION_PORTS=ENABLE CONFIGURATION=CFG ;
BANK 0 VCCIO 3.3 V;
BANK 1 VCCIO 3.3 V;
BANK 2 VCCIO 3.3 V;
BANK 3 VCCIO 3.3 V;
VOLTAGE 3.300 V;
USE PRIMARY NET "clk" ;
// https://github.com/danderson/ulxs/blob/main/lpf.md
LOCATE COMP "LED_OD" SITE "PL5C" ;
LOCATE COMP "PROGRAMN" SITE "PT9B" ;
LOCATE COMP "SCL" SITE "PT8C" ;
LOCATE COMP "SDA" SITE "PT8D" ;
LOCATE COMP "I2S_BCK" SITE "PT7B" ;
LOCATE COMP "I2S_DAT" SITE "PT7A" ;
LOCATE COMP "I2S_WS" SITE "PT6D" ;
LOCATE COMP "FPGA_CLK" SITE "PT6C" ;
LOCATE COMP "TUNER_CLK" SITE "PL5D" ;
LOCATE COMP "D0" SITE "PB2A" ;
LOCATE COMP "D1" SITE "PB2C" ;
LOCATE COMP "D2" SITE "PB2D" ;
LOCATE COMP "D3" SITE "PB4A" ;
LOCATE COMP "D4" SITE "PB4B" ;
LOCATE COMP "D5" SITE "PB4C" ;
LOCATE COMP "D6" SITE "PB4D" ;
LOCATE COMP "D7" SITE "PB9A" ;
LOCATE COMP "DATA_VALID" SITE "PB9B" ;
LOCATE COMP "SYNC" SITE "PR5B" ;
IOBUF PORT "LED_OD" OPENDRAIN=ON DRIVE=4 PULLMODE=NONE IO_TYPE=LVCMOS33 ;
IOBUF PORT "PROGRAMN" PULLMODE=NONE IO_TYPE=LVCMOS33 ;
IOBUF PORT "SCL" PULLMODE=UP IO_TYPE=LVCMOS33 ;
IOBUF PORT "SDA" PULLMODE=UP IO_TYPE=LVCMOS33 ;
IOBUF PORT "I2S_BCK" PULLMODE=NONE IO_TYPE=LVCMOS33 ;
IOBUF PORT "I2S_DAT" PULLMODE=NONE IO_TYPE=LVCMOS33 ;
IOBUF PORT "I2S_WS" PULLMODE=NONE IO_TYPE=LVCMOS33 ;
IOBUF PORT "FPGA_CLK" PULLMODE=NONE IO_TYPE=LVCMOS33 DRIVE=NA SLEWRATE=NA CLAMP=ON ;
IOBUF PORT "TUNER_CLK" PULLMODE=NONE IO_TYPE=LVCMOS33 ;
IOBUF PORT "D0" PULLMODE=NONE IO_TYPE=LVCMOS33 ;
IOBUF PORT "D1" PULLMODE=NONE IO_TYPE=LVCMOS33 ;
IOBUF PORT "D2" PULLMODE=NONE IO_TYPE=LVCMOS33 ;
IOBUF PORT "D3" PULLMODE=NONE IO_TYPE=LVCMOS33 ;
IOBUF PORT "D4" PULLMODE=NONE IO_TYPE=LVCMOS33 ;
IOBUF PORT "D5" PULLMODE=NONE IO_TYPE=LVCMOS33 ;
IOBUF PORT "D6" PULLMODE=NONE IO_TYPE=LVCMOS33 ;
IOBUF PORT "D7" PULLMODE=NONE IO_TYPE=LVCMOS33 ;
IOBUF PORT "DATA_VALID" PULLMODE=NONE IO_TYPE=LVCMOS33 ;
IOBUF PORT "SYNC" PULLMODE=NONE IO_TYPE=LVCMOS33 ;
